---
import Header from "../components/Header.astro";
import Hero from "../components/Hero.astro";
import About from "../components/About.astro";
import Projects from "../components/Projects.astro";
import Experience from "../components/Experience.astro";
import Education from "../components/Education.astro";
import Footer from "../components/Footer.astro";
import { getSiteConfig, getUi } from "../i18n";
import type { Lang } from "../i18n/types";
import "../styles/global.css";

const lang: Lang = "en";
const siteConfig = getSiteConfig(lang);
const uiConfig = getUi(lang);
---

<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={siteConfig.description} />
    <title>{siteConfig.name} - {siteConfig.title}</title>
    <link rel="alternate" hreflang="en" href="/en/" />
    <link rel="alternate" hreflang="zh" href="/zh/" />
    <script is:inline>
      (function(){var t=localStorage.getItem('theme');if(t==='dark'||(!t&&matchMedia('(prefers-color-scheme:dark)').matches)){document.documentElement.classList.add('dark')}})()
    </script>
  </head>
  <body>
    <Header config={siteConfig} ui={uiConfig} currentLang="en" />
    <section>
      <Hero config={siteConfig} ui={uiConfig} />
      <About config={siteConfig} ui={uiConfig} />
      <Projects config={siteConfig} ui={uiConfig} />
      <Experience config={siteConfig} ui={uiConfig} />
      <Education config={siteConfig} ui={uiConfig} />
    </section>
    <Footer config={siteConfig} ui={uiConfig} />
  </body>
</html>
