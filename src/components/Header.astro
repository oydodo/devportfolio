---
import type { SiteConfig, UiConfig, Lang } from "../i18n/types";
import { languages } from "../i18n/types";

interface Props {
  config: SiteConfig;
  ui: UiConfig;
  currentLang: Lang;
}

const { config: siteConfig, ui, currentLang } = Astro.props;

const hasProjects = siteConfig.projects && siteConfig.projects.length > 0;
const hasExperience = siteConfig.experience && siteConfig.experience.length > 0;
const hasEducation = siteConfig.education && siteConfig.education.length > 0;

const altLang = languages.find((l) => l.code !== currentLang)!;
---

<header
  id="header"
  class="fixed top-0 left-0 right-0 z-50 hidden md:block transition-all duration-300"
>
  <nav class="max-w-7xl mx-auto px-8 py-4">
    <ul class="flex items-center gap-8 justify-center">
      <li>
        <a
          href="#about"
          class="text-gray-700 hover:text-black dark:text-gray-300 dark:hover:text-white transition-colors font-medium"
        >
          {ui.about}
        </a>
      </li>
      {
        hasProjects && (
          <li>
            <a
              href="#projects"
              class="text-gray-700 hover:text-black dark:text-gray-300 dark:hover:text-white transition-colors font-medium"
            >
              {ui.projects}
            </a>
          </li>
        )
      }
      {
        hasExperience && (
          <li>
            <a
              href="#experience"
              class="text-gray-700 hover:text-black dark:text-gray-300 dark:hover:text-white transition-colors font-medium"
            >
              {ui.experience}
            </a>
          </li>
        )
      }
      {
        hasEducation && (
          <li>
            <a
              href="#education"
              class="text-gray-700 hover:text-black dark:text-gray-300 dark:hover:text-white transition-colors font-medium"
            >
              {ui.education}
            </a>
          </li>
        )
      }
      <li>
        <button
          data-theme-toggle
          aria-label="Toggle dark mode"
          class="p-2 rounded-lg text-gray-700 hover:text-black dark:text-gray-300 dark:hover:text-white transition-colors"
        >
          <svg data-theme-icon="sun" class="w-5 h-5 hidden" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364 6.364l-.707-.707M6.343 6.343l-.707-.707m12.728 0l-.707.707M6.343 17.657l-.707.707M16 12a4 4 0 11-8 0 4 4 0 018 0z" />
          </svg>
          <svg data-theme-icon="moon" class="w-5 h-5 hidden" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20.354 15.354A9 9 0 018.646 3.646 9.003 9.003 0 0012 21a9.003 9.003 0 008.354-5.646z" />
          </svg>
        </button>
      </li>
      <li>
        <a
          href={`/${altLang.code}/`}
          class="px-2 py-1 rounded-lg text-sm font-medium text-gray-700 hover:text-black dark:text-gray-300 dark:hover:text-white transition-colors border border-gray-300 dark:border-gray-600"
        >
          {altLang.label}
        </a>
      </li>
    </ul>
  </nav>
</header>

<header class="fixed top-4 right-4 z-50 md:hidden">
  <div class="flex items-center gap-2 rounded-full border border-gray-200 dark:border-gray-800 bg-white/80 dark:bg-gray-950/80 backdrop-blur-sm shadow-sm px-2 py-2">
    <button
      data-theme-toggle
      aria-label="Toggle dark mode"
      class="p-2 rounded-full text-gray-700 hover:text-black dark:text-gray-300 dark:hover:text-white transition-colors"
    >
      <svg data-theme-icon="sun" class="w-5 h-5 hidden" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364 6.364l-.707-.707M6.343 6.343l-.707-.707m12.728 0l-.707.707M6.343 17.657l-.707.707M16 12a4 4 0 11-8 0 4 4 0 018 0z" />
      </svg>
      <svg data-theme-icon="moon" class="w-5 h-5 hidden" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20.354 15.354A9 9 0 018.646 3.646 9.003 9.003 0 0012 21a9.003 9.003 0 008.354-5.646z" />
      </svg>
    </button>
    <a
      href={`/${altLang.code}/`}
      class="px-3 py-1.5 rounded-full text-sm font-medium text-gray-700 hover:text-black dark:text-gray-300 dark:hover:text-white transition-colors border border-gray-300 dark:border-gray-600"
    >
      {altLang.label}
    </a>
  </div>
</header>

<script>
  // Header scroll effect
  window.addEventListener("scroll", () => {
    const header = document.getElementById("header");
    if (window.scrollY > 100) {
      header?.classList.add("bg-white/80", "dark:bg-gray-950/80", "backdrop-blur-sm");
    } else {
      header?.classList.remove("bg-white/80", "dark:bg-gray-950/80", "backdrop-blur-sm");
    }
  });

  // Theme toggle
  function updateThemeIcons() {
    const isDark = document.documentElement.classList.contains("dark");
    document.querySelectorAll("[data-theme-toggle]").forEach((toggle) => {
      const sun = toggle.querySelector('[data-theme-icon="sun"]');
      const moon = toggle.querySelector('[data-theme-icon="moon"]');
      if (sun) sun.classList.toggle("hidden", !isDark);
      if (moon) moon.classList.toggle("hidden", isDark);
    });
  }

  function toggleTheme() {
    const html = document.documentElement;
    if (html.classList.contains("dark")) {
      html.classList.remove("dark");
      localStorage.setItem("theme", "light");
    } else {
      html.classList.add("dark");
      localStorage.setItem("theme", "dark");
    }
    updateThemeIcons();
  }

  updateThemeIcons();

  document.querySelectorAll("[data-theme-toggle]").forEach((toggle) => {
    toggle.addEventListener("click", toggleTheme);
  });

  // Listen for system preference changes
  matchMedia("(prefers-color-scheme: dark)").addEventListener("change", (e) => {
    if (!localStorage.getItem("theme")) {
      document.documentElement.classList.toggle("dark", e.matches);
      updateThemeIcons();
    }
  });
</script>

<style>
  html {
    scroll-behavior: smooth;
  }
</style>
